# 이 프로젝트는 Spring Boot 프로필 파일(application-local.yml)로 로컬 키를 관리합니다.
# 이 파일은 "어떤 환경변수가 있는지" 한눈에 보기 위한 참고용 목록입니다 (배포 시 Railway Variables에 같은 이름으로 넣음).
# 실제 로컬 설정은 backend/src/main/resources/application-local.yml.example 을 복사해서 사용하세요.
# 발급 방법: docs/API_KEYS.md

# 영수증 OCR (없으면 Stub)
NAVER_OCR_INVOKE_URL=
NAVER_OCR_SECRET_KEY=

# 주소 검색 (행정안전부 도로명주소 API, 없으면 Stub)
JUSO_API_KEY=
# 주소 → 좌표 변환 (카카오 로컬 API, 없으면 Stub)
KAKAO_REST_API_KEY=

# 시연 안정성 플래그 — 전부 기본 false. 운영에서는 꺼둘 것
# true면 GPS 2차 확인 시 요청 좌표 대신 건물 좌표를 써서 항상 통과
LOCATION_CHECK_DEMO_MODE=false
# true면 주소 API 오류·타임아웃 시 데모 건물 목록으로 대체 (false면 오류 안내)
ADDRESS_DEMO_FALLBACK=false
# true면 기동 시 1회 시연용 건물·좌표·팟 시드 생성
DEMO_SEED=false
