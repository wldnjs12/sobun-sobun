# 이 프로젝트는 Spring Boot 프로필 파일(application-local.yml)로 로컬 키를 관리합니다.
# 이 파일은 "어떤 키가 필요한지" 한눈에 보기 위한 참고용 목록입니다.
# 실제 설정은 backend/src/main/resources/application-local.yml.example 을 복사해서 사용하세요.
# 발급 방법: docs/API_KEYS.md

NAVER_OCR_INVOKE_URL=
